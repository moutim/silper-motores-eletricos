# Copie para .env e preencha. Nunca commite o .env nem o .sheet-token.json.

# Google OAuth (login da conta da Silper + acesso à planilha e ao Drive)
# O URI http://localhost:3000/api/auth/callback/google precisa estar autorizado no cliente OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js (gere com: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# URL pública do app (conteúdo do QR Code: {APP_URL}/m/{rastreio})
APP_URL=http://localhost:3000

# Nome da planilha criada no Drive da conta (opcional)
# SHEET_NAME=SilperMotores

# Parâmetros de negócio pendentes ficam em src/lib/config.ts (ver docs/DECISOES.md)
